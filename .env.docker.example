# Copy to .env.docker and protect with chmod 600. Never commit the real file.
# Generate two different random values; see deploy/README.md.
POSTGRES_PASSWORD=
EMAIL_SETTINGS_KEY=

# Local browser entry point. On a server use the HTTPS overlay below.
APP_PORT=8080
PUBLIC_APP_URL=http://localhost:8080

# For compose.https.yaml: a real DNS name pointing to your Docker host.
DOMAIN=

# Optional alternative to Google email configured through HRMO settings.
RESEND_API_KEY=
EMAIL_FROM=
